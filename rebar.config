%% -*- mode: Erlang; fill-column: 80; comment-column: 75; -*-
%% Dependencies ================================================================
% ProjectI: dependency repositories and commits are locked.
{deps,[{rebar_vsn_plugin,".*",
                         {git,"https://github.com/huynhngocthuy48572-lgtm/projecti-dep-rebar_vsn_plugin.git",
                              "fd40c960c7912193631d948fe962e1162a8d1334"}}]}.
